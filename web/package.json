{
  "name": "deltasports-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "PATH=../scripts/bin:$PATH; next build && next export && node ../scripts/sync-next-output.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "verify-env": "node ../scripts/verify-env.mjs",
    "test-api-keys": "node ../scripts/test-api-keys.mjs",
    "setup-supabase": "bash ../scripts/setup-supabase.sh",
    "check-config": "npm run verify-env && npm run test-api-keys"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.17",
    "dotenv": "^16.4.5",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.3",
    "patch-package": "^8.0.0",
    "postcss": "8.4.35",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
